# Copier ce fichier en .env puis remplacer les valeurs.
# Ne jamais commiter le fichier .env.

# --- Base de données PostgreSQL ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=changer_moi
POSTGRES_DB=atelier_couture
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://atelier:changer_moi@localhost:5432/atelier_couture
# Base dédiée aux tests pytest (créée automatiquement, vidée à chaque test)
TEST_DATABASE_URL=postgresql+psycopg://atelier:changer_moi@localhost:5432/atelier_couture_test

# --- JWT ---
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changer_moi_par_une_longue_cle_aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Premier administrateur (python -m app.seed) ---
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=changer_moi_123
ADMIN_NOM_COMPLET="Alassane Administrateur"

# --- Comptes de démonstration accueil + tailleur (python -m app.seed --demo) ---
DEMO_PASSWORD=changer_moi_demo

# --- Docker (docker compose up --build) ---
# Port publié de l'API sur la machine hôte
API_PORT=8000
# Lancer python -m app.seed au démarrage du conteneur (admin + catalogue)
RUN_SEED=true
# Créer aussi les comptes de démonstration au démarrage du conteneur
SEED_DEMO=true
